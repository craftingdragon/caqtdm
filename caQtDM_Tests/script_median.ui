   <widget class="caScript" name="medianScript">
    <property name="geometry">
     <rect>
      <x>270</x>
      <y>305</y>
      <width>420</width>
      <height>48</height>
     </rect>
    </property>
    <property name="displayMode">
     <enum>caScript::LastOutput</enum>
    </property>
    <property name="executionMode">
     <enum>caScript::DataDriven</enum>
    </property>
    <property name="triggerMode">
     <enum>caScript::Manual</enum>
    </property>
    <property name="script">
     <string>var samples = inputs.samples.value.slice();
var threshold = inputs.threshold.value;
if (samples.length === 0) {
    throw new Error("Die Waveform ist leer.");
}
var count = 0;
for (var i = 0; i &lt; samples.length; ++i) {
    if (samples[i] &gt; threshold) {
        ++count;
    }
}
samples.sort(function(a, b) { return a - b; });
var middle = Math.floor(samples.length / 2);
var median = samples.length % 2
    ? samples[middle]
    : (samples[middle - 1] + samples[middle]) / 2;
outputs.median.value = median;
outputs.aboveThreshold.value = count;</string>
    </property>
    <property name="channels">
     <string>[{"alias":"samples","channel":"internal://scriptSamples"},{"alias":"threshold","channel":"internal://scriptThreshold"}]</string>
    </property>
    <property name="outputChannels">
     <string>[{"alias":"median","channel":"internal://scriptMedian"},{"alias":"aboveThreshold","channel":"internal://scriptAboveThreshold"}]</string>
    </property>
   </widget>
