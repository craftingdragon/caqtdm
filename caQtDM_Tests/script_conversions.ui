     <string>[{"alias": "wave", "channel": "internal://conversionArraywave"}, {"alias": "matrix", "channel": "internal://conversionArraymatrix"}, {"alias": "strings", "channel": "internal://conversionArraystrings"}]</string>
    </property>
    <property name="outputChannels">
     <string>[{"alias": "waveValue", "channel": "internal://conversionArrayswaveValue"}, {"alias": "waveCheck", "channel": "internal://conversionArrayswaveCheck"}, {"alias": "matrixValue", "channel": "internal://conversionArraysmatrixValue"}, {"alias": "matrixCheck", "channel": "internal://conversionArraysmatrixCheck"}, {"alias": "stringsValue", "channel": "internal://conversionArraysstringsValue"}, {"alias": "stringsCheck", "channel": "internal://conversionArraysstringsCheck"}]</string>
