    <property name="script">
     <string>const source = inputs.source;
try { const v = source.convert(EpicsType.String); outputs.toString.value = typeof v + ': ' + String(v); }
catch (e) { outputs.toString.value = e.name + ': ' + e.message; }
try { const v = source.convert(EpicsType.Short); outputs.toShort.value = typeof v + ': ' + String(v); }
catch (e) { outputs.toShort.value = e.name + ': ' + e.message; }
try { const v = source.convert(EpicsType.Long); outputs.toLong.value = typeof v + ': ' + String(v); }
catch (e) { outputs.toLong.value = e.name + ': ' + e.message; }
try { const v = source.convert(EpicsType.Char); outputs.toChar.value = typeof v + ': ' + String(v); }
catch (e) { outputs.toChar.value = e.name + ': ' + e.message; }
try { const v = source.convert(EpicsType.Enum); outputs.toEnum.value = typeof v + ': ' + String(v); }
catch (e) { outputs.toEnum.value = e.name + ': ' + e.message; }
try { const v = source.convert(EpicsType.Float); outputs.toFloat.value = typeof v + ': ' + String(v); }
catch (e) { outputs.toFloat.value = e.name + ': ' + e.message; }
try { const v = source.convert(EpicsType.Double); outputs.toDouble.value = typeof v + ': ' + String(v); }
catch (e) { outputs.toDouble.value = e.name + ': ' + e.message; }
console.log('Source after conversions:', source.value);</string>
    </property>
   </widget>
