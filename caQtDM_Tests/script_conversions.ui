     <string>[{"alias": "toString", "channel": "internal://conversionDoubletoString"}, {"alias": "toShort", "channel": "internal://conversionDoubletoShort"}, {"alias": "toLong", "channel": "internal://conversionDoubletoLong"}, {"alias": "toChar", "channel": "internal://conversionDoubletoChar"}, {"alias": "toEnum", "channel": "internal://conversionDoubletoEnum"}, {"alias": "toFloat", "channel": "internal://conversionDoubletoFloat"}, {"alias": "toDouble", "channel": "internal://conversionDoubletoDouble"}]</string>
    </property>
