    <property name="outputChannels">
     <string>[{"alias": "utf8Raw", "channel": "internal://conversionBytesutf8Raw"}, {"alias": "utf8Utf8", "channel": "internal://conversionBytesutf8Utf8"}, {"alias": "utf8Latin1", "channel": "internal://conversionBytesutf8Latin1"}, {"alias": "latin1Raw", "channel": "internal://conversionByteslatin1Raw"}, {"alias": "latin1Utf8", "channel": "internal://conversionByteslatin1Utf8"}, {"alias": "latin1Latin1", "channel": "internal://conversionByteslatin1Latin1"}]</string>
