     <enum>caScript::Manual</enum>
    </property>
    <property name="script">
     <string>outputs.waveValue.value = JSON.stringify(inputs.wave.value);
let waveRejected = 0;
for (const t of ['String','Short','Long','Char','Enum','Float','Double']) { try { inputs.wave.convert(EpicsType[t]); } catch (e) { ++waveRejected; } }
outputs.waveCheck.value = waveRejected + '/7 rejected (expected 7/7)';
outputs.matrixValue.value = JSON.stringify(inputs.matrix.value);
let matrixRejected = 0;
for (const t of ['String','Short','Long','Char','Enum','Float','Double']) { try { inputs.matrix.convert(EpicsType[t]); } catch (e) { ++matrixRejected; } }
outputs.matrixCheck.value = matrixRejected + '/7 rejected (expected 7/7)';
outputs.stringsValue.value = JSON.stringify(inputs.strings.value);
let stringsRejected = 0;
for (const t of ['String','Short','Long','Char','Enum','Float','Double']) { try { inputs.strings.convert(EpicsType[t]); } catch (e) { ++stringsRejected; } }
outputs.stringsCheck.value = stringsRejected + '/7 rejected (expected 7/7)';
</string>
