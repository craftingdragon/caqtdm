    <property name="script">
     <string>{ const c = inputs.utf8; outputs.utf8Raw.value = Array.prototype.map.call(c.rawBytes, function(b) { return ('0' + b.toString(16)).slice(-2); }).join(' '); }
{ const c = inputs.utf8; outputs.utf8Utf8.value = c.fromUtf8(); }
{ const c = inputs.utf8; outputs.utf8Latin1.value = c.fromLatin1(); }
{ const c = inputs.latin1; outputs.latin1Raw.value = Array.prototype.map.call(c.rawBytes, function(b) { return ('0' + b.toString(16)).slice(-2); }).join(' '); }
{ const c = inputs.latin1; outputs.latin1Utf8.value = c.fromUtf8(); }
{ const c = inputs.latin1; outputs.latin1Latin1.value = c.fromLatin1(); }
</string>
    </property>
