          </property>
          <property name="script">
           <string notr="true">const scenario = inputs.scenario.value;
if (scenario === 2) {
    throw new Error("Example JavaScript error");
}
if (scenario === 4) {
    // Demonstrate the caScript execution deadline.
    while (true) {}
}
if (scenario === 0 || scenario === 1) {
    outputs.result.value = scenario === 0 ? 42 : 84;
}</string>
