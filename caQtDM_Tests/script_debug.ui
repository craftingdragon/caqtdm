          <property name="displayMode">
           <enum>caScript::Diagnostics</enum>
          </property>
          <property name="executionMode">
           <enum>caScript::DataDriven</enum>
          </property>
          <property name="triggerMode">
           <enum>caScript::AnyInput</enum>
          </property>
          <property name="script">
           <string notr="true">const scenario = inputs.scenario.value;
if (scenario === 2) {
    throw new Error("Example JavaScript error");
}
if (scenario === 4) {
    // Demonstrate the caScript execution deadline.
    while (true) {}
}
if (scenario === 0) {
    console.log("Example info message from a successful run.");
} else if (scenario === 1) {
    console.warn("Example warning. The script still completed.");
} else if (scenario === 3) {
    outputs.result.value = "not a number";
}</string>
          </property>
