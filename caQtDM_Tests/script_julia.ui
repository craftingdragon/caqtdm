      </item>
      <item>
       <widget class="caScript" name="requestRender">
        <property name="executionMode">
         <enum>caScript::DataDriven</enum>
        </property>
        <property name="channels">
         <string notr="true">[{"channel":"internal://juliaResolution.{\"caqtdm_monitor\":{\"maxdisplayrate\":50}}","alias":"resolution"},{"channel":"internal://juliaIterations.{\"caqtdm_monitor\":{\"maxdisplayrate\":50}}","alias":"iterations"},{"channel":"internal://juliaZoomStep.{\"caqtdm_monitor\":{\"maxdisplayrate\":50}}","alias":"zoomStep"},{"channel":"internal://juliaReal.{\"caqtdm_monitor\":{\"maxdisplayrate\":50}}","alias":"real"},{"channel":"internal://juliaImaginary.{\"caqtdm_monitor\":{\"maxdisplayrate\":50}}","alias":"imaginary"},{"channel":"internal://juliaRadius.{\"caqtdm_monitor\":{\"maxdisplayrate\":50}}","alias":"radius"}]</string>
        </property>
        <property name="outputChannels">
         <string notr="true">[{"channel":"internal://juliaRenderRequest","alias":"request"}]</string>
        </property>
        <property name="script">
         <string notr="true">this.request = (this.request || 0) + 1;
const clamp = (value, low, high) =&gt; Math.max(low, Math.min(high, value));
outputs.request.value = JSON.stringify([
    inputs.resolution.value, clamp(Math.round(inputs.iterations.value), 32, 1024),
    clamp(Math.round(inputs.zoomStep.value), 0, 160),
    clamp(inputs.real.value, -2, 2), clamp(inputs.imaginary.value, -2, 2),
    clamp(inputs.radius.value, 0, 0.25), this.request
]);</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="caScript" name="juliaScript">
        <property name="executionMode">
         <enum>caScript::DataDriven</enum>
        </property>
        <property name="triggerMode">
         <enum>caScript::Periodic</enum>
        </property>
        <property name="triggerInterval">
         <number>50</number>
        </property>
        <property name="channels">
         <string notr="true">[{"channel":"internal://juliaWidth.{\"caqtdm_monitor\":{\"maxdisplayrate\":50}}","alias":"cameraWidth"},{"channel":"internal://juliaHeight.{\"caqtdm_monitor\":{\"maxdisplayrate\":50}}","alias":"cameraHeight"},{"channel":"internal://juliaImageClick.{\"caqtdm_monitor\":{\"maxdisplayrate\":50}}","alias":"click"},{"channel":"internal://juliaRenderRequest.{\"caqtdm_monitor\":{\"maxdisplayrate\":50}}","alias":"request"},{"channel":"internal://juliaAnimation.{\"caqtdm_monitor\":{\"maxdisplayrate\":50}}","alias":"animation"},{"channel":"internal://juliaReset.{\"caqtdm_monitor\":{\"maxdisplayrate\":50}}","alias":"reset"}]</string>
        </property>
        <property name="outputChannels">
         <string notr="true">[{"channel":"internal://juliaWidth","alias":"cameraWidth"},{"channel":"internal://juliaHeight","alias":"cameraHeight"},{"channel":"internal://juliaPixels","alias":"image"},{"channel":"internal://juliaRenderProgress","alias":"progress"},{"channel":"internal://juliaParameter","alias":"parameter"}]</string>
        </property>
        <property name="script">
         <string notr="true">const request = inputs.request.value;
if (request !== this.lastRequest) {
    const [resolution, iterations, zoomStep, real, imaginary, radius] = JSON.parse(request);
    this.settings = {resolution, iterations, zoom: Math.round(Math.pow(2, zoomStep / 8)),
                     real, imaginary, radius};
    this.lastRequest = request;
}

const settings = this.settings;
const published = this.published;
const reset = inputs.reset.value;
const click = inputs.click.value;
if (this.lastReset === undefined || reset !== this.lastReset) {
    this.centerReal = 0;
    this.centerImaginary = 0;
    if (this.lastReset !== undefined) settings.zoom = 1;
} else if (click !== this.lastClick &amp;&amp; published) {
    const point = click.split(",");
    const x = Number(point[1]), y = Number(point[2]);
    if (point.length === 3 &amp;&amp; x &gt;= 0 &amp;&amp; x &lt;= 1 &amp;&amp; y &gt;= 0 &amp;&amp; y &lt;= 1) {
        this.centerReal = published.real + (x - 0.5) * 3.2 / published.zoom;
        this.centerImaginary = published.imaginary + (0.5 - y) * 2.4 / published.zoom;
    }
}
this.lastReset = reset;
this.lastClick = click;

const reportProgress = (percent) =&gt; {
    if (percent === this.lastProgress) return;
    outputs.progress.value = percent;
    this.lastProgress = percent;
};
const width = settings.resolution === 1 ? 640 : 256;
const height = width * 3 / 4;
const zoom = settings.zoom;
const real = this.centerReal, imaginary = this.centerImaginary;
const iterations = settings.iterations;
const key = [width, iterations, zoom, real, imaginary,
             settings.real, settings.imaginary, settings.radius].join(",");
const animate = inputs.animation.value !== 0 &amp;&amp; settings.radius &gt; 0;
const now = Date.now();
const deadline = now + 25;
const phaseCount = 120;
const phase = published ? published.phase : 0;
let frame = this.frame;
if (frame &amp;&amp; (frame.key !== key || (!animate &amp;&amp; frame.phase !== phase))) {
    this.frame = frame = null;
}
if (!frame) {
    if (published &amp;&amp; published.key === key &amp;&amp; this.camera.width === width &amp;&amp;
        (!animate || now - published.time &lt; 100)) {
        reportProgress(100);
        return;
    }

    // Changes to the view or parameter settings keep the displayed phase.
    const nextPhase = animate &amp;&amp; published &amp;&amp; published.key === key ? (phase + 1) % phaseCount : phase;
    const angle = 2 * Math.PI * nextPhase / phaseCount;
    const cr = settings.real + settings.radius * Math.cos(angle);
    const ci = settings.imaginary + settings.radius * Math.sin(angle);
    const escapeRadius = Math.max(2, Math.hypot(cr, ci));
    const step = 3.2 / (width * zoom);
    const realCoordinates = new Float64Array(width);
    for (let x = 0; x &lt; width; ++x)
        realCoordinates[x] = real + (x + 0.5 - width / 2) * step;
    frame = this.frame = {key, phase: nextPhase, cr, ci, limit: escapeRadius * escapeRadius,
                          step, realCoordinates, row: 0, column: 0,
                          // RGB1_CA expects space for an extra RGB triplet.
                          pixels: new Uint8Array(width * height * 3 + 3)};
    reportProgress(0);
}

if (this.paletteLimit !== iterations) {
    const colors = new Uint8Array((iterations + 1) * 3);
    for (let i = 0; i &lt; iterations; ++i) {
        const t = Math.log(i + 1) / Math.log(iterations);
        colors[i * 3] = Math.round(14 + 241 * t * t);
        colors[i * 3 + 1] = Math.round(24 + 216 * t);
        colors[i * 3 + 2] = Math.round(52 + 176 * Math.sin(t * Math.PI / 2));
    }
    this.colors = colors;
    this.paletteLimit = iterations;
}

if (!this.escapeCount) {
    this.escapeCount = function(zr, zi, cr, ci, limit, iterations) {
        let zrSquared = zr * zr, ziSquared = zi * zi;
        let count = 0;
        let checkpointReal = zr, checkpointImaginary = zi, nextCheckpoint = 32;
        while (count &lt; iterations &amp;&amp; zrSquared + ziSquared &lt;= limit) {
            const blockEnd = Math.min(iterations, count + 32);
            do {
                zi = 2 * zr * zi + ci;
                zr = zrSquared - ziSquared + cr;
                zrSquared = zr * zr;
                ziSquared = zi * zi;
                ++count;
            } while (count &lt; blockEnd &amp;&amp; zrSquared + ziSquared &lt;= limit);
            if (zr === checkpointReal &amp;&amp; zi === checkpointImaginary) return iterations;
            if (count === nextCheckpoint) {
                checkpointReal = zr;
                checkpointImaginary = zi;
                nextCheckpoint *= 2;
            }
        }
        return zrSquared + ziSquared &gt; limit ? count : iterations;
    };
}
const colors = this.colors;
while (frame.row &lt; height &amp;&amp; Date.now() &lt; deadline) {
    const zi = imaginary + (height / 2 - frame.row - 0.5) * frame.step;
    const end = Math.min(frame.column + 64, width);
    let index = (frame.row * width + frame.column) * 3;
    for (let x = frame.column; x &lt; end; ++x) {
        const color = 3 * this.escapeCount(frame.realCoordinates[x], zi, frame.cr, frame.ci,
                                          frame.limit, iterations);
        frame.pixels[index++] = colors[color];
        frame.pixels[index++] = colors[color + 1];
        frame.pixels[index++] = colors[color + 2];
    }
    frame.column = end;
    if (end === width) {
        ++frame.row;
        frame.column = 0;
    }
}
if (frame.row &lt; height || Date.now() &gt;= deadline) {
    reportProgress(Math.floor(99 * (frame.row + frame.column / width) / height));
    return;
}

// Width, height and image are delivered to caCamera on separate monitors.
if (!this.camera) {
    this.camera = {width: inputs.cameraWidth.value, height: inputs.cameraHeight.value, readyAfter: 0};
}
const camera = this.camera;
const finished = Date.now();
if (camera.width !== width || camera.height !== height) {
    reportProgress(99);
    if (published &amp;&amp; finished - published.time &lt; 200) return;
    outputs.cameraWidth.value = camera.width = width;
    outputs.cameraHeight.value = camera.height = height;
    camera.readyAfter = finished + 100;
    return;
}
if (finished &lt; camera.readyAfter || inputs.cameraWidth.value !== width ||
    inputs.cameraHeight.value !== height || (published &amp;&amp; finished - published.time &lt; 100)) {
    reportProgress(99);
    return;
}

outputs.image.value = frame.pixels.buffer;
outputs.parameter.value = frame.cr.toFixed(7) + (frame.ci &lt; 0 ? " - " : " + ") +
                          Math.abs(frame.ci).toFixed(7) + "i";
reportProgress(100);
this.published = {key, phase: frame.phase, zoom, real, imaginary, time: finished};
this.frame = null;</string>
        </property>
       </widget>
      </item>
      <item>
