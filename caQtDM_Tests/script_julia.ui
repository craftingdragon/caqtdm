        <property name="outputChannels">
         <string notr="true">[{"channel":"internal://juliaZoomStep","alias":"zoomStep"},{"channel":"internal://juliaReset","alias":"reset"}]</string>
        </property>
        <property name="script">
         <string notr="true">this.reset = (this.reset || 0) + 1;
outputs.zoomStep.value = 0;
outputs.reset.value = this.reset;</string>
        </property>
