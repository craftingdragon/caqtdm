  <widget class="caScript" name="pacmanScript">
   <property name="geometry">
    <rect>
     <x>20</x>
     <y>285</y>
     <width>670</width>
     <height>45</height>
    </rect>
   </property>
   <property name="show">
    <bool>true</bool>
   </property>
   <property name="triggerMode">
    <enum>caScript::TriggerMode::Periodic</enum>
   </property>
