     <item>
      <widget class="caScript" name="mandelbrotScript">
       <property name="minimumSize">
        <size>
         <width>280</width>
         <height>32</height>
        </size>
       </property>
       <property name="show">
        <bool>true</bool>
       </property>
       <property name="executionMode">
        <enum>caScript::DataDriven</enum>
       </property>
       <property name="channels">
        <string notr="true">[{"channel":"internal://mandelbrotWidth","alias":"width"},{"channel":"internal://mandelbrotHeight","alias":"height"}]</string>
       </property>
       <property name="outputChannels">
        <string notr="true">[{"channel":"internal://mandelbrotPixels","alias":"image"}]</string>
       </property>
       <property name="script">
        <string notr="true">const width = inputs.width.value;
const height = inputs.height.value;
const maxIterations = 96;
const pixels = new Array(width * height);
const step = 3.2 / width;
const colorScale = 225 / Math.log(maxIterations);

for (let y = 0; y &lt; height; ++y) {
    const ci = (height / 2 - y) * step;
    const ciSquared = ci * ci;
    for (let x = 0; x &lt; width; ++x) {
        const cr = -2.2 + x * step;
        const index = y * width + x;

        // Points in the main cardioid or period-2 bulb cannot escape.
        const offset = cr - 0.25;
        const q = offset * offset + ciSquared;
        if (q * (q + offset) &lt;= 0.25 * ciSquared ||
            (cr + 1) * (cr + 1) + ciSquared &lt;= 0.0625) {
            pixels[index] = 0;
            continue;
        }

        let zr = 0, zi = 0;
        let zrSquared = 0, ziSquared = 0;
        let iterations = 0;
        while (iterations &lt; maxIterations &amp;&amp; zrSquared + ziSquared &lt;= 4) {
            zi = 2 * zr * zi + ci;
            zr = zrSquared - ziSquared + cr;
            zrSquared = zr * zr;
            ziSquared = zi * zi;
            ++iterations;
        }
        pixels[index] = iterations === maxIterations
            ? 0 : Math.round(30 + colorScale * Math.log(iterations));
    }
}
outputs.image.value = pixels;</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
