      <item>
       <widget class="caScript" name="mandelbrotScript">
        <property name="executionMode">
         <enum>caScript::DataDriven</enum>
        </property>
        <property name="triggerMode">
         <enum>caScript::Periodic</enum>
        </property>
        <property name="triggerInterval">
         <number>50</number>
        </property>
        <property name="channels">
         <string notr="true">[{"channel":"internal://mandelbrotWidth","alias":"cameraWidth"},{"channel":"internal://mandelbrotHeight","alias":"cameraHeight"},{"channel":"internal://mandelbrotResolution","alias":"resolution"},{"channel":"internal://mandelbrotIterations","alias":"iterations"},{"channel":"internal://mandelbrotPalette","alias":"palette"},{"channel":"internal://mandelbrotZoom","alias":"zoom"},{"channel":"internal://mandelbrotReal","alias":"real"},{"channel":"internal://mandelbrotImaginary","alias":"imaginary"},{"channel":"internal://mandelbrotImageClick","alias":"click"}]</string>
        </property>
        <property name="outputChannels">
         <string notr="true">[{"channel":"internal://mandelbrotWidth","alias":"cameraWidth"},{"channel":"internal://mandelbrotHeight","alias":"cameraHeight"},{"channel":"internal://mandelbrotPixels","alias":"image"},{"channel":"internal://mandelbrotReal","alias":"real"},{"channel":"internal://mandelbrotImaginary","alias":"imaginary"}]</string>
        </property>
        <property name="script">
         <string notr="true">const click = inputs.click.value;
if (click !== this.lastClick) {
    this.lastClick = click;
    const point = click.split(",");
    const view = this.publishedView;
    if (view &amp;&amp; point.length === 3) {
        // Convert the selected point in the last published image, even if a new frame is rendering.
        outputs.real.value = view.real + (Number(point[1]) - 0.5) * 3.2 / view.zoom;
        outputs.imaginary.value = view.imaginary + (0.5 - Number(point[2])) * 2.4 / view.zoom;
        return;
    }
}

const widths = [256, 640, 1280];
const width = widths[inputs.resolution.value];
const height = width * 3 / 4;
const iterations = inputs.iterations.value;
const palette = inputs.palette.value;
const zoom = inputs.zoom.value;
const real = inputs.real.value;
const imaginary = inputs.imaginary.value;
const geometry = [width, height, iterations, zoom, real, imaginary].join(',');
const step = 3.2 / (width * zoom);
const colorScale = 225 / Math.log(iterations);
const symmetric = imaginary === 0;
// Row zero has no partner on this sampling grid.
const rows = symmetric ? Math.floor(height / 2) + 1 : height;

if (!this.frame || this.frame.geometry !== geometry) {
    const realCoordinates = new Float64Array(width);
    const cardioidOffsets = new Float64Array(width);
    const cardioidSquares = new Float64Array(width);
    const bulbSquares = new Float64Array(width);
    for (let x = 0; x &lt; width; ++x) {
        const cr = real + (x - width / 2) * step;
        const offset = cr - 0.25;
        realCoordinates[x] = cr;
        cardioidOffsets[x] = offset;
        cardioidSquares[x] = offset * offset;
        bulbSquares[x] = (cr + 1) * (cr + 1);
    }
    this.frame = {
        geometry, realCoordinates, cardioidOffsets, cardioidSquares, bulbSquares,
        intensities: new Uint8Array(width * height), row: 0, publishedPalette: -1
    };
}

const frame = this.frame;
if (frame.publishedPalette === palette) return;

const deadline = Date.now() + 25;
while (frame.row &lt; rows) {
    const y = frame.row++;
    const ci = imaginary + (height / 2 - y) * step;
    const ciSquared = ci * ci;
    const cardioidLimit = 0.25 * ciSquared;
    const rowOffset = y * width;
    for (let x = 0; x &lt; width; ++x) {
        const q = frame.cardioidSquares[x] + ciSquared;
        if (q * (q + frame.cardioidOffsets[x]) &lt;= cardioidLimit ||
            frame.bulbSquares[x] + ciSquared &lt;= 0.0625) continue;
        const cr = frame.realCoordinates[x];
        let zr = 0, zi = 0, zrSquared = 0, ziSquared = 0, count = 0;
        while (count &lt; iterations &amp;&amp; zrSquared + ziSquared &lt;= 4) {
            zi = 2 * zr * zi + ci;
            zr = zrSquared - ziSquared + cr;
            zrSquared = zr * zr;
            ziSquared = zi * zi;
            ++count;
        }
        if (count &lt; iterations)
            frame.intensities[rowOffset + x] = Math.round(30 + colorScale * Math.log(count));
    }
    if (symmetric &amp;&amp; y &gt; 0 &amp;&amp; height - y !== y)
        frame.intensities.copyWithin((height - y) * width, rowOffset, rowOffset + width);
    if (Date.now() &gt;= deadline) break;
}
if (frame.row &lt; rows) return;

if (!frame.rgb || frame.rgb.palette !== palette) {
    const stops = [
        [[6, 15, 48], [15, 69, 140], [49, 176, 209], [246, 209, 115], [255, 251, 233]],
        [[41, 0, 9], [134, 8, 16], [220, 42, 10], [250, 158, 31], [255, 250, 190]]
    ];
    const colors = new Uint8Array(256 * 3);
    for (let i = 1; i &lt;= 255; ++i) {
        const scale = (i - 1) * 4 / 254;
        const segment = Math.min(3, Math.floor(scale));
        const fraction = scale - segment;
        for (let channel = 0; channel &lt; 3; ++channel) {
            const low = palette === 2 ? i : stops[palette][segment][channel];
            const high = palette === 2 ? i : stops[palette][segment + 1][channel];
            colors[i * 3 + channel] = Math.round(low + fraction * (high - low));
        }
    }

    // The RGB1_CA decoder checks for another RGB triplet after the final row.
    frame.rgb = {palette, colors, pixels: new Uint8Array(width * height * 3 + 3), row: 0};
}

const rgb = frame.rgb;
while (rgb.row &lt; height) {
    const first = rgb.row++ * width;
    for (let i = first, pixel = first * 3; i &lt; first + width; ++i) {
        const color = frame.intensities[i] * 3;
        rgb.pixels[pixel++] = rgb.colors[color];
        rgb.pixels[pixel++] = rgb.colors[color + 1];
        rgb.pixels[pixel++] = rgb.colors[color + 2];
    }
    if (Date.now() &gt;= deadline) break;
}
if (rgb.row &lt; height) return;

// caCamera receives dimensions and image data on separate monitors. Let the
// previous frame reach the camera, then publish dimensions before the next frame.
const now = Date.now();
if (!this.camera) {
    this.camera = {width: inputs.cameraWidth.value, height: inputs.cameraHeight.value,
                   readyAfter: 0, lastImage: 0};
}
const camera = this.camera;
if (camera.width !== width || camera.height !== height) {
    if (now - camera.lastImage &lt; 200) return;
    outputs.cameraWidth.value = camera.width = width;
    outputs.cameraHeight.value = camera.height = height;
    camera.readyAfter = now + 100;
    return;
}
if (now &lt; camera.readyAfter || inputs.cameraWidth.value !== width ||
    inputs.cameraHeight.value !== height) return;

outputs.image.value = rgb.pixels.buffer;
this.publishedView = {real, imaginary, zoom};
camera.lastImage = now;
frame.publishedPalette = palette;
frame.rgb = null;</string>
        </property>
       </widget>
