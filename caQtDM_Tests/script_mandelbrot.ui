        <property name="outputChannels">
         <string notr="true">[{"channel":"internal://mandelbrotZoom","alias":"zoom"},{"channel":"internal://mandelbrotReal","alias":"real"},{"channel":"internal://mandelbrotImaginary","alias":"imaginary"}]</string>
        </property>
        <property name="script">
         <string notr="true">outputs.zoom.value = 1;
outputs.real.value = -0.6;
outputs.imaginary.value = 0;</string>
        </property>
       </widget>
      </item>
