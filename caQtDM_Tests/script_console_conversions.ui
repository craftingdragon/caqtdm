   <widget class="caScript" name="convertScript">
    <property name="geometry">
     <rect>
      <x>0</x>
      <y>0</y>
      <width>1</width>
      <height>1</height>
     </rect>
    </property>
    <property name="triggerMode">
     <enum>caScript::TriggerMode::Manual</enum>
    </property>
    <property name="executionMode">
     <enum>caScript::ExecutionMode::DataDriven</enum>
    </property>
    <property name="channels">
     <string>[{"alias": "source", "channel": "internal://scriptConsoleSource"}]</string>
    </property>
    <property name="script">
     <string>outputs.short.value = inputs.source.convert(EpicsType.Short);
outputs.long.value = inputs.source.convert(EpicsType.Long);
outputs.char.value = inputs.source.convert(EpicsType.Char);
outputs.enum.value = inputs.source.convert(EpicsType.Enum);
outputs.float.value = inputs.source.convert(EpicsType.Float);
outputs.double.value = inputs.source.convert(EpicsType.Double);
outputs.string.value = inputs.source.convert(EpicsType.String);
console.log("Conversions completed; original input:", inputs.source.value);</string>
    </property>
    <property name="outputChannels">
     <string>[{"alias": "short", "channel": "internal://scriptConsoleShort"}, {"alias": "long", "channel": "internal://scriptConsoleLong"}, {"alias": "char", "channel": "internal://scriptConsoleChar"}, {"alias": "enum", "channel": "internal://scriptConsoleEnum"}, {"alias": "float", "channel": "internal://scriptConsoleFloat"}, {"alias": "double", "channel": "internal://scriptConsoleDouble"}, {"alias": "string", "channel": "internal://scriptConsoleString"}]</string>
    </property>
   </widget>
   <widget class="caScript" name="finiteScript">
    <property name="geometry">
     <rect>
      <x>0</x>
      <y>0</y>
      <width>1</width>
      <height>1</height>
     </rect>
    </property>
    <property name="triggerMode">
     <enum>caScript::TriggerMode::Manual</enum>
    </property>
    <property name="executionMode">
     <enum>caScript::ExecutionMode::DataDriven</enum>
    </property>
    <property name="channels">
     <string>[{"alias": "source", "channel": "internal://scriptConsoleSource"}]</string>
    </property>
    <property name="script">
     <string>for (var i = 0; i &lt; 1000; ++i) {
    const value = inputs.source.convert(EpicsType.Double);
    if (i % 3 === 0) console.log('converted', value);
    else if (i % 3 === 1) console.warn('converted', value);
    else console.error('converted', value);
}</string>
    </property>
   </widget>
   <widget class="caScript" name="endlessScript">
    <property name="geometry">
     <rect>
      <x>0</x>
      <y>0</y>
      <width>1</width>
      <height>1</height>
     </rect>
    </property>
    <property name="triggerMode">
     <enum>caScript::TriggerMode::Manual</enum>
    </property>
    <property name="executionMode">
     <enum>caScript::ExecutionMode::DataDriven</enum>
    </property>
    <property name="channels">
     <string>[{"alias": "source", "channel": "internal://scriptConsoleSource"}]</string>
    </property>
    <property name="script">
     <string>while (true) {
    const value = inputs.source.convert(EpicsType.String);
    console.log('converted', value);
}</string>
    </property>
   </widget>
  </widget>
