    <property name="outputChannels">
     <string>[{"channel":"internal://scriptScaledScore","alias":"result"}]</string>
    </property>
    <property name="script">
     <string>if (!("value" in inputs.score) || !("value" in inputs.factor)) {
    throw new Error("Input values are not available yet");
}
outputs.result.value = inputs.score.value * inputs.factor.value;</string>
